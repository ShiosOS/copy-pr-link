{
  "name": "copy-pr-link",
  "version": "0.1.0",
  "description": "Copy a GitHub PR as a rich-text hyperlink (Pull Request 1234: Title) that pastes as a clickable link in Slack, email, and docs.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "ShiosOS",
  "homepage": "https://github.com/ShiosOS/copy-pr-link",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShiosOS/copy-pr-link.git"
  },
  "bugs": {
    "url": "https://github.com/ShiosOS/copy-pr-link/issues"
  },
  "keywords": [
    "browser-extension",
    "chrome-extension",
    "firefox-addon",
    "github",
    "pull-request",
    "clipboard"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ext": "web-ext lint --source-dir .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "web-ext build --source-dir . --artifacts-dir dist",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run lint:ext && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "chrome-webstore-upload-cli": "^4.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
