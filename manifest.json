{
  "manifest_version": 3,
  "name": "Copy PR Link",
  "version": "0.1.0",
  "description": "Copy a GitHub PR as a rich-text hyperlink (Pull Request 1234: Title) that pastes as a clickable link in Slack, email, and docs.",
  "browser_specific_settings": {
    "gecko": {
      "id": "copy-pr-link@shios",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "112.0"
    }
  },
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "scripting", "clipboardWrite"],
  "host_permissions": ["https://github.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Copy PR Link",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "copy-pr-link": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Copy current PR as a rich-text link"
    }
  }
}
